# Copy this file to ".env" (same folder) and fill in your own values.
# .env is loaded automatically (via python-dotenv) by both the reference
# notebooks in codigo/ and the modular backend in src/.
#
# NEVER commit a real .env file or paste real keys into this .env.example
# template — see .gitignore, and section 15 of the project's own
# requirements ("Never commit .env", "Never expose GEMINI_API_KEY and
# llmwhisperer api_key to the frontend").

# --- LLM providers (src/llm/) --------------------------------------------
# Rule 5 (process/material semantic matching), the ACE 18 rule-condition
# fallback, and both summary steps are backed by whichever provider is
# selected per-request ("gemini" or "groq" - see src/llm/service.py and,
# in the Streamlit app, the "LLM Provider" dropdown). Fill in the key(s)
# for whichever provider(s) you intend to use; a provider's key is only
# ever read when that provider is actually selected.

# Gemini - get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional - defaults to "gemini-3.6-flash" if not set.
GEMINI_MODEL=gemini-3.6-flash

# Optional - minimum seconds between consecutive Gemini calls from this
# process, to stay under your account's requests-per-minute limit.
# Defaults to 4.0 if not set.
GEMINI_MIN_INTERVAL_SECONDS=4.0

# Groq - get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional - defaults to "openai/gpt-oss-120b" if not set. The
# Streamlit app's model dropdown lists models live from the Groq API
# when a key is configured; see src/llm/groq.py:FALLBACK_MODELS otherwise.
GROQ_MODEL=openai/gpt-oss-120b

# Optional - minimum seconds between consecutive Groq calls from this
# process. Defaults to 2.0 if not set.
GROQ_MIN_INTERVAL_SECONDS=2.0

# --- LLM Whisperer (src/djo/extractor.py) -------------------------------
# Required to OCR a DJO PDF. Get a key at https://unstract.com
LLMWHISPERER_API_KEY=

# Optional - seconds to wait for one OCR job to finish. Defaults to 200.
LLMWHISPERER_WAIT_TIMEOUT=200

# --- ACE 18 data (src/config.py) ----------------------------------------
# Optional - override only if your ACE 18 PDF/cache live somewhere other
# than the project's dados/ folder. Leave unset to use the defaults.
# ACE18_PDF_PATH=
# ACE18_CACHE_PATH=
