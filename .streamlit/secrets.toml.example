# Template for Streamlit Community Cloud's Secrets panel
# (App settings -> Secrets). Copy the keys below into that panel and fill
# in real values there — NEVER create a real ".streamlit/secrets.toml" in
# this repository (it's git-ignored on purpose; see ../.gitignore).
#
# For local development, use ../.env instead (see ../.env.example) —
# app.py bridges whichever of these is present (.env locally, st.secrets
# on Streamlit Cloud) into the same os.environ variables the backend
# already reads, so no code differs between the two environments.

# Required for the "Gemini" provider option in the app.
GEMINI_API_KEY = ""

# Required for the "Groq" provider option in the app.
GROQ_API_KEY = ""

# Required for ANY DJO PDF to be processed (OCR) — the app cannot
# function without this one, regardless of which LLM provider is chosen.
LLMWHISPERER_API_KEY = ""

# --- Optional overrides (uncomment only if you need to change a default) ---
# GEMINI_MODEL = "gemini-3.6-flash"
# GEMINI_MIN_INTERVAL_SECONDS = "4.0"
# GROQ_MODEL = "openai/gpt-oss-120b"
# GROQ_MIN_INTERVAL_SECONDS = "2.0"
# LLMWHISPERER_WAIT_TIMEOUT = "200"
